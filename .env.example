# Copy to .env and fill in the provider you intend to use.
# You only need to set the one(s) you actually use.

LLM_PROVIDER=deepseek       # one of: deepseek | anthropic | openai | gemini

# DeepSeek (OpenAI-protocol compatible, cheap, strong on Chinese)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Fetch window in hours (how far back to pull articles)
FETCH_WINDOW_HOURS=24
# Max articles to pull per source
MAX_PER_SOURCE=10

# Copy to .env and fill in the provider you intend to use.
# You only need to set the one(s) you actually use.

LLM_PROVIDER=deepseek       # one of: deepseek | anthropic | openai | gemini

# DeepSeek (OpenAI-protocol compatible, cheap, strong on Chinese)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Fetch window in hours (how far back to pull articles)
FETCH_WINDOW_HOURS=72
# Max articles to pull per source (bumped to 15 for the wider 3-day window)
MAX_PER_SOURCE=15

# ─── 微信 (iLink) 守护进程 ────────────────────────────────────────────────
# 设为 true 后，uvicorn 启动时会一并启动微信 bot（首次会弹二维码）。
# 不设或 false → 不启动微信，FastAPI 后端独立运行。
WECHAT_ENABLED=false

# 凭证文件路径（保存 token 和每用户的 context_token，重启不必重新扫码）
WECHAT_CREDENTIALS_PATH=~/.ai_news_wechat.json

# 白名单 user_id（逗号分隔）。留空 = 任何 DM bot 的人都可用。
# 在 CoW 测试时 user_id 可在日志 [wechat-dispatch] 行里找到。
WECHAT_WHITELIST_USER_IDS=

# 每日推送：true 时 8 点拉 Top-N 国家分析自动发到 target
WECHAT_DAILY_PUSH_ENABLED=false
WECHAT_DAILY_PUSH_HOUR=8
WECHAT_DAILY_PUSH_MINUTE=0
WECHAT_DAILY_PUSH_TOP_N=3
WECHAT_DAILY_PUSH_TARGET=

# 热点告警：true 时每小时检查，某国 ≥5 篇且为昨日 3 倍以上才推送
WECHAT_HOT_ALERT_ENABLED=false
WECHAT_HOT_ALERT_INTERVAL_MIN=60
WECHAT_HOT_ALERT_MIN_COUNT=5
WECHAT_HOT_ALERT_JUMP_RATIO=3.0
WECHAT_HOT_ALERT_TARGET=

# 单次分析上限和超时
WECHAT_ANALYZE_MAX_ARTICLES=10
WECHAT_ANALYZE_TIMEOUT=600
